{
  "name": "@investhesis/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-zod": "1.0.3",
    "@investhesis/domain": "workspace:*",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "oxlint": "1.92.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
