# Copy to apps/api/.env (git-ignored): `cp apps/api/.env.example apps/api/.env`.
# `pnpm --filter @investhesis/api dev` loads it with `node --env-file-if-exists`; the app never loads dotenv.

NODE_ENV=development            # development | test | production (required)
PORT=3000                       # the web dev server proxies /api to http://localhost:3000
LOG_LEVEL=info                  # pino level

# Supabase Postgres. Use the direct connection or the session pooler (port 5432),
# not the transaction pooler (port 6543): prepared statements break there.
# Local Supabase (`supabase start`): postgres://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: Project Settings → Database → Connection string, add ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MAX=10

PUBLIC_WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173   # comma-separated; defaults to PUBLIC_WEB_ORIGIN

# Auth. v1 has no sign-in: every request runs as this one user. `mock` is refused in production.
AUTH_MODE=mock
MOCK_USER_ID=0192f0a0-0000-7000-8000-000000000001   # a UUID; every row is written with this user id
MOCK_USER_EMAIL=investor@example.com
MOCK_USER_NAME=Investor

SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false
