{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@supabase/supabase-js",
            "message": "Import the AuthClient port instead; only features/auth/supabase-auth-client.ts may use supabase-js."
          },
          {
            "name": "i18next",
            "message": "Import from '@/i18n'; only src/i18n/ may use i18next. Components use react-i18next's useTranslation and Trans."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/features/auth/supabase-auth-client.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/i18n/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
