{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@supabase/supabase-js",
            "message": "Import the AuthClient port instead; only features/auth/supabase-auth-client.ts may use supabase-js."
          },
          {
            "name": "i18next",
            "message": "Use react-i18next hooks in components; only src/i18n/ imports i18next."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/features/auth/supabase-auth-client.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "i18next",
                "message": "Use react-i18next hooks in components; only src/i18n/ imports i18next."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/i18n/**",
        "src/test/**",
        "src/routers/route-handle.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@supabase/supabase-js",
                "message": "Import the AuthClient port instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
