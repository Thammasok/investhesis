# supabase (real sign-in) or mock (the API runs as its mock user; no sign-in, no token).
VITE_AUTH_MODE=mock
# Required when VITE_AUTH_MODE=supabase. The local stack (`supabase start`) listens on 54321;
# the publishable key is public and safe in the bundle (see supabase status).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
