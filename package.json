{
  "name": "investhesis",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @investhesis/web dev",
    "dev:api": "pnpm --filter @investhesis/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:keys": "node scripts/db-keys.mjs",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:supabase": "vitest run --config scripts/vitest.config.mts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.2",
    "supabase": "3.2.0",
    "vitest": "5.1.0"
  }
}
